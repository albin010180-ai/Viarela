# Copy values from Supabase > Project Settings > API
# Add these in Vercel > Project > Settings > Environment Variables

SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Admin panel (/admin/) — public "anon" key, protected by RLS
SUPABASE_ANON_KEY=your-anon-public-key

# Monero bridge does NOT use this file - it reads services/monero/config.json
# (supabaseUrl + supabaseServiceRoleKey + wallet-rpc login). See services/monero/README.md
